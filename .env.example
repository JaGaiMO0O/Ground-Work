# Copy to .env and fill in.
#
# .env is gitignored, and agents are instructed never to read or echo it.
# ADAPTERS read these variables. The agent never does — it invokes the adapter,
# and the adapter reaches for credentials on its own.
#
# Every account here must be READ-ONLY. No adapter is permitted to write.

# --- Oracle : scripts/adapters/db/oracle.sh -------------------------------
ORACLE_USER=analyst_ro
ORACLE_PASSWORD=
ORACLE_DSN=host:1521/SERVICE
# Comma-separated schema owners to snapshot, e.g. BILL01,CORE
ORACLE_SCHEMAS=

# --- Postgres : scripts/adapters/db/postgres.sh ---------------------------
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=analyst_ro
PGPASSWORD=

# --- REST capture : scripts/adapters/capture/rest.py ----------------------
CAPTURE_BASE_URL=
CAPTURE_AUTH_HEADER=
